#
#   cmake -DCC=<C compiler> -DSRC=<source dir> -DWORK=<scratch dir> -P tests/deps_cache_test.cmake
#
# The dependency cache (cmake/deps_cache.cmake, cmake/deps_publish.cmake): one folder per exact build, the same from
# any build tree, another for any change of source, configure line, compiler or recipe, found only once complete, and
# published whole, never over a finished one.
foreach(var CC SRC WORK)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "deps_cache_test.cmake needs -D${var}=...")
    endif()
endforeach()
include("${SRC}/cmake/deps_cache.cmake")
file(REMOVE_RECURSE "${WORK}")
set(CMAKE_C_COMPILER "${CC}")
set(CMAKE_C_COMPILER_ID Clang)
set(CMAKE_C_COMPILER_VERSION 23.1.0)

function(fail what)
    message(FATAL_ERROR "deps_cache: ${what}")
endfunction()

# where a recipe file (this text) would build "lib" with KEY..., seen from build tree TREE, in a configure of its own
function(dir_of out tree recipe)
    set(PROJECT_BINARY_DIR "${WORK}/${tree}")
    set_property(GLOBAL PROPERTY snx_deps_headers "")
    set(key ${ARGN})
    file(WRITE "${WORK}/recipes/${tree}.cmake" "${recipe}\nsnx_deps_cached(lib found \${key})\n")
    include("${WORK}/recipes/${tree}.cmake")
    set(${out} "${found_DIR}" PARENT_SCOPE)
    set(${out}_FOUND "${found_FOUND}" PARENT_SCOPE)
endfunction()

# no cache: each tree builds its own
set(SNX_DEPS_CACHE "")
dir_of(none tree0 "# recipe" "source: 1")
if(none OR none_FOUND)
    fail("no folder without SNX_DEPS_CACHE")
endif()

set(SNX_DEPS_CACHE "${WORK}/cache")
dir_of(a tree1 "# recipe" "source: 1" "configure: --x")
dir_of(b tree2 "# recipe" "source: 1" "configure: --x")
if(NOT a STREQUAL b)
    fail("the same build is one folder from any tree (got ${a} and ${b})")
endif()
if(a_FOUND)
    fail("a folder is not found before it exists")
endif()
file(MAKE_DIRECTORY "${a}/lib")
dir_of(a tree1 "# recipe" "source: 1" "configure: --x")
if(a_FOUND)
    fail("a folder is not found before it is complete")
endif()
file(REMOVE_RECURSE "${a}")
dir_of(c tree3 "# recipe" "source: 2" "configure: --x")
if(c STREQUAL a)
    fail("another source is another folder")
endif()
dir_of(d tree4 "# recipe" "source: 1" "configure: --y")
if(d STREQUAL a)
    fail("another configure line is another folder")
endif()
dir_of(e tree5 "# another recipe" "source: 1" "configure: --x")
if(e STREQUAL a)
    fail("another recipe file is another folder")
endif()
set(CMAKE_C_COMPILER_VERSION 23.1.1)
dir_of(f tree6 "# recipe" "source: 1" "configure: --x")
if(f STREQUAL a)
    fail("another compiler version is another folder")
endif()
set(CMAKE_C_COMPILER_VERSION 23.1.0)
file(READ "${WORK}/tree1/snx-deps/lib.dir" listed)
get_filename_component(name "${a}" NAME)
if(NOT listed STREQUAL "${name}\n")
    fail("the tree names the folder it uses")
endif()

# publishing: whole, marked complete, and never over a finished folder
file(WRITE "${WORK}/install1/lib/libx.a" "first")
file(WRITE "${WORK}/install2/lib/libx.a" "second")
foreach(install install1 install2)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DFROM=${WORK}/${install}" "-DTO=${a}"
                            "-DKEY=${WORK}/tree1/snx-deps/lib.key" -P "${SRC}/cmake/deps_publish.cmake"
                    RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        fail("deps_publish.cmake runs (${install})")
    endif()
endforeach()
file(READ "${a}/lib/libx.a" kept)
if(NOT kept STREQUAL "first")
    fail("the first published build stays")
endif()
file(READ "${a}/snx-complete" complete)
file(READ "${WORK}/tree1/snx-deps/lib.key" key)
if(NOT complete STREQUAL key)
    fail("the folder holds its key")
endif()
# a tree that loses the race (another one's folder is there, not yet marked complete) copies nothing (its FROM is not
# there) and leaves the folder as it is
dir_of(h tree8 "# recipe" "source: 3")
file(WRITE "${h}/lib/libx.a" "other tree")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DFROM=${WORK}/not-installed" "-DTO=${h}"
                        "-DKEY=${WORK}/tree8/snx-deps/lib.key" -P "${SRC}/cmake/deps_publish.cmake" RESULT_VARIABLE rc)
file(READ "${h}/lib/libx.a" kept)
if(NOT rc EQUAL 0 OR NOT kept STREQUAL "other tree")
    fail("a folder that is there is not replaced, and nothing is copied")
endif()
file(GLOB partial "${SNX_DEPS_CACHE}/*.partial-*")
if(partial)
    fail("no partial copy is left (${partial})")
endif()
dir_of(g tree7 "# recipe" "source: 1" "configure: --x")
if(NOT (g_FOUND AND g STREQUAL a))
    fail("a complete folder is found")
endif()
message(STATUS "deps_cache: ok")
