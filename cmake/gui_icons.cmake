# The menus' icons (src/gui/icons.h): their 16x16 glyphs, src/gui/icons.hex, a Unifont .hex line each in icons.h's
# order from U+E000, compiled into scarletnx-common beside the VGA font as gui_icon_font. An icon without its line, a
# line of another code point, an 8x16 or a blank glyph, and a line past the list stop the configure, naming the icon.
# cmake -DICONS_H=icons.h -DICONS_HEX=icons.hex [-DOUT=gui_icons.c] -P cmake/gui_icons.cmake checks two files the same
# way (tests/gui_icons.cmake)
include_guard(GLOBAL)

# out: the C source of hex's glyphs, the icons named in header's enum; FATAL_ERROR with the icon for any it refuses
function(snx_gui_icons header hex out)
    file(READ "${header}" text)
    string(REGEX MATCH "GUI_ICON_[A-Z0-9_]+ = 0xE000,[^}]*GUI_ICON_END" block "${text}")
    if(NOT block)
        message(FATAL_ERROR "${header}: no enum from a GUI_ICON_ = 0xE000 to GUI_ICON_END")
    endif()
    string(REGEX MATCHALL "GUI_ICON_[A-Z0-9_]+" names "${block}")
    list(REMOVE_ITEM names GUI_ICON_END)
    list(LENGTH names count)
    file(READ "${hex}" lines)
    string(REPLACE "\r" "" lines "${lines}")
    string(REGEX REPLACE "\n$" "" lines "${lines}")
    string(REPLACE "\n" ";" lines "${lines}")
    list(LENGTH lines have)
    set(c "/* Generated by cmake/gui_icons.cmake from src/gui/icons.hex. Do not edit. */\n#include \"gui/icons.h\"\n")
    string(APPEND c "const uint8_t gui_icon_font[] = {\n")
    set(i 0)
    foreach(name IN LISTS names)
        math(EXPR point "57344 + ${i}" OUTPUT_FORMAT HEXADECIMAL) # 0xE000
        string(SUBSTRING "${point}" 2 -1 point)
        string(TOUPPER "${point}" point)
        math(EXPR number "${i} + 1")
        if(i GREATER_EQUAL have)
            message(FATAL_ERROR "${hex}: no glyph for ${name} (U+${point}), which line ${number} holds")
        endif()
        list(GET lines ${i} line)
        if(NOT line MATCHES "^([0-9A-F]+):([0-9A-F]+)$")
            message(FATAL_ERROR "${hex}:${number}: \"${line}\" is not a line of a Unifont .hex, ${name}'s (U+${point})")
        endif()
        set(at "${CMAKE_MATCH_1}")
        set(bits "${CMAKE_MATCH_2}")
        if(NOT at STREQUAL point)
            message(FATAL_ERROR "${hex}:${number}: U+${at} where ${name}'s U+${point} goes: a line each, in "
                                "src/gui/icons.h's order")
        endif()
        string(LENGTH "${bits}" digits)
        if(NOT digits EQUAL 64)
            message(FATAL_ERROR "${hex}:${number}: ${name} (U+${point}) has ${digits} hex digits: an icon is 16x16, 64")
        endif()
        if(bits MATCHES "^0+$")
            message(FATAL_ERROR "${hex}:${number}: ${name} (U+${point}) is blank")
        endif()
        foreach(half 0 2) # the left half's 16 rows, then the right's
            set(row "   ")
            foreach(r RANGE 15)
                math(EXPR from "${r} * 4 + ${half}")
                string(SUBSTRING "${bits}" ${from} 2 byte)
                string(TOLOWER "${byte}" byte)
                string(APPEND row " 0x${byte},")
            endforeach()
            if(half)
                string(APPEND c "${row} /* ${name}, right */\n")
            else()
                string(APPEND c "${row} /* ${name}, left */\n")
            endif()
        endforeach()
        math(EXPR i "${i} + 1")
    endforeach()
    if(have GREATER count)
        list(GET lines ${count} line)
        list(GET names -1 last)
        math(EXPR number "${count} + 1")
        message(FATAL_ERROR "${hex}:${number}: \"${line}\" is past the icons of ${header}, ${last} the last")
    endif()
    string(APPEND c "};\n")
    # file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
    file(CONFIGURE OUTPUT "${out}" CONTENT "${c}")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    if(NOT OUT)
        set(OUT "${CMAKE_CURRENT_BINARY_DIR}/gui_icons_check.c")
    endif()
    snx_gui_icons("${ICONS_H}" "${ICONS_HEX}" "${OUT}")
    return()
endif()

set(snx_gui_icons_h "${PROJECT_SOURCE_DIR}/src/gui/icons.h")
set(snx_gui_icons_hex "${PROJECT_SOURCE_DIR}/src/gui/icons.hex")
set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${snx_gui_icons_h}"
             "${snx_gui_icons_hex}")
set(snx_gui_icons_c "${CMAKE_BINARY_DIR}/generated/gui_icons.c")
snx_gui_icons("${snx_gui_icons_h}" "${snx_gui_icons_hex}" "${snx_gui_icons_c}")
