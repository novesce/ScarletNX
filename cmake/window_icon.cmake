# snx_window_icon: the program's icon on the windows it opens, from the 128 PNG of dist/icons compiled in, which SDL
# decodes and hands the window system. Windows takes the executable's own instead (runtime.rc), with every size
include_guard(GLOBAL)
set(snx_window_icon_png "${PROJECT_SOURCE_DIR}/dist/icons/hicolor/128x128/apps/wimsy.png")
set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${snx_window_icon_png}")
file(READ "${snx_window_icon_png}" snx_window_icon_hex HEX)
string(LENGTH "${snx_window_icon_hex}" snx_window_icon_size)
math(EXPR snx_window_icon_size "${snx_window_icon_size} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," snx_window_icon_bytes "${snx_window_icon_hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n    " snx_window_icon_bytes "${snx_window_icon_bytes}")
# file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/window_icon_png.c" @ONLY CONTENT
"/* Generated by cmake/window_icon.cmake from dist/icons/hicolor/128x128/apps/wimsy.png. Do not edit. */
#include <stddef.h>
extern const unsigned char snx_window_icon_png[];
extern const size_t snx_window_icon_png_size;
const unsigned char snx_window_icon_png[] = {
    @snx_window_icon_bytes@
};
const size_t snx_window_icon_png_size = @snx_window_icon_size@;
")
add_library(snx_window_icon STATIC "${PROJECT_SOURCE_DIR}/src/common/utilities/window_icon.c"
    "${PROJECT_BINARY_DIR}/generated/window_icon_png.c")
target_link_libraries(snx_window_icon PUBLIC SDL3::SDL3)
target_compile_options(snx_window_icon PRIVATE -Wall -Wextra -Werror=missing-prototypes)
if(BUILD_TESTING)
    add_executable(snx-test-window-icon "${PROJECT_SOURCE_DIR}/tests/window_icon.c")
    target_link_libraries(snx-test-window-icon PRIVATE snx_window_icon)
    target_compile_definitions(snx-test-window-icon PRIVATE SNX_WINDOW_ICON_FILE="${snx_window_icon_png}")
    target_compile_options(snx-test-window-icon PRIVATE -Wall -Wextra -Werror -UNDEBUG)
    add_test(NAME window_icon COMMAND snx-test-window-icon)
    set_tests_properties(window_icon PROPERTIES ENVIRONMENT "SDL_VIDEO_DRIVER=dummy")
endif()
