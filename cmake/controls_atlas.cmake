# snx_controls_png: the on-screen controls' atlas (dist/controls/controls.png, made by scripts/build-controls.py)
# compiled into the runtime, which SDL decodes when the window opens (runtime/platform/backend/sdl3.c)
include_guard(GLOBAL)
set(snx_controls_png "${PROJECT_SOURCE_DIR}/dist/controls/controls.png")
set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${snx_controls_png}")
file(READ "${snx_controls_png}" snx_controls_hex HEX)
string(LENGTH "${snx_controls_hex}" snx_controls_size)
math(EXPR snx_controls_size "${snx_controls_size} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," snx_controls_bytes "${snx_controls_hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n    " snx_controls_bytes "${snx_controls_bytes}")
# file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/controls_png.c" @ONLY CONTENT
"/* Generated by cmake/controls_atlas.cmake from dist/controls/controls.png. Do not edit. */
#include <stddef.h>
extern const unsigned char snx_controls_png[];
extern const size_t snx_controls_png_size;
const unsigned char snx_controls_png[] = {
    @snx_controls_bytes@
};
const size_t snx_controls_png_size = @snx_controls_size@;
")
